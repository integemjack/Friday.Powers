+void cosyvoice_set_dit_prompt_prefix(cosyvoice_context_t ctx, bool enabled)
+{
+    if (auto model = dynamic_cast<cosyvoice_model*>(ctx))
+    {
+        model->shared->dit_prompt_prefix = enabled;
+        for (uint32_t i = 0; i != model->shared->params.n_workers; ++i)
+        {
+            model->workers[i].dit_prefix_key = 0;
+            model->workers[i].dit_prefix_len = 0;
+        }
+    }
