{
  "schema": 2,
  "id": "llm",
  "title": "本地大模型",
  "detail": "用本机 GPU 跑大模型（llama.cpp）：多个请求一起算，主智能体和同时派出的子智能体共用系统提示、不重复算（基数树前缀共享）；模型在模型库里选、按需下载（魔搭 / Hugging Face 上的 GGUF）；不联网、不花钱。",
  "executable": "friday-llm",
  "serve": [
    "serve",
    "--models",
    "{library}",
    "--host",
    "127.0.0.1",
    "--port",
    "0",
    "--token",
    "{token}",
    "--parent-stdin"
  ],
  "capabilities": [
    "chat"
  ],
  "library": {
    "format": "gguf",
    "kinds": [
      "text",
      "multimodal"
    ]
  },
  "options": [
    {
      "key": "parallel",
      "title": "同时处理的请求",
      "detail": "同时算几个请求（主智能体、每个子智能体各一个），多的排队。自动按显存定；子智能体多、上下文不长时可以调高，上下文很长时调高反而可能更慢。改了以后本地大模型重新启动（正在回答的会被打断）。",
      "env": "FRIDAY_LLM_PARALLEL",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "title": "自动（按显存）"
        },
        {
          "value": 1,
          "title": "1 个"
        },
        {
          "value": 2,
          "title": "2 个"
        },
        {
          "value": 4,
          "title": "4 个"
        },
        {
          "value": 6,
          "title": "6 个"
        },
        {
          "value": 8,
          "title": "8 个"
        },
        {
          "value": 12,
          "title": "12 个"
        },
        {
          "value": 16,
          "title": "16 个"
        },
        {
          "value": 24,
          "title": "24 个"
        },
        {
          "value": 32,
          "title": "32 个"
        },
        {
          "value": 48,
          "title": "48 个"
        },
        {
          "value": 64,
          "title": "64 个"
        }
      ]
    }
  ],
  "models": [],
  "targets": {
    "windows-x64-vulkan": {
      "detail": "Windows x64，Vulkan（单个 exe，NVIDIA / AMD / Intel 显卡都能用；默认）",
      "models": []
    },
    "windows-x64-cuda13": {
      "detail": "Windows x64，NVIDIA CUDA（cuBLAS 在共用的 CUDA 13 运行库里，第一次装 CUDA 版时下载；预填长提示更快）",
      "models": [],
      "runtime": "cuda13"
    },
    "macos-arm64-metal": {
      "detail": "macOS，Apple 芯片，Metal",
      "models": []
    },
    "linux-x64-vulkan": {
      "detail": "Linux x64，Vulkan（NVIDIA / AMD / Intel 显卡都能用；默认）",
      "models": []
    },
    "linux-x64-cuda": {
      "detail": "Linux x64，NVIDIA CUDA（cudart、cuBLAS 静态链接，包大）",
      "models": []
    },
    "linux-arm64-jetson-orin": {
      "detail": "Jetson Orin（JetPack 6.x）",
      "models": []
    },
    "linux-arm64-vulkan": {
      "detail": "ARM64 Linux，Vulkan（高通 Adreno 等，要 ARMv8.2 的 CPU）",
      "models": []
    }
  }
}
