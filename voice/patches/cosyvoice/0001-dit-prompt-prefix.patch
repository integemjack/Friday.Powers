+// Friday patch: identifies the prompt whose DiT KV prefix is cached (FNV-1a over flow tokens, mel and speaker embedding).
+static uint64_t dit_prompt_prefix_key(const cosyvoice_prompt* prompt)
+{
+    uint64_t h = 1469598103934665603ull;
+    const auto mix = [&h](const void* data, size_t size)
+    {
+        const auto p = static_cast<const unsigned char*>(data);
+        for (size_t i = 0; i != size; ++i)
+        {
+            h ^= p[i];
+            h *= 1099511628211ull;
+        }
+    };
+    const auto& feat = prompt->prompt_speech_feat;
+    const auto& emb = prompt->flow_embedding;
+    mix(feat.shape, sizeof(feat.shape));
+    mix(prompt->flow_prompt_speech_tokens.first.get(), sizeof(int) * prompt->flow_prompt_speech_tokens.second);
+    mix(feat.data, sizeof(float) * feat.shape[0] * feat.shape[1]);
+    mix(emb.data, sizeof(float) * emb.shape[0] * emb.shape[1]);
+    return h | 1;
 }
 
